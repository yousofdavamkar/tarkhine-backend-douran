{
  "permissions": {
    "allow": [
      "Bash(dir)",
      "Bash(npm install:*)",
      "Bash(npm run prisma:generate:*)",
      "Bash(npm run prisma:migrate:*)",
      "Bash(npx prisma migrate:*)",
      "Bash(npx prisma db push:*)",
      "Bash(set SKIP_GENERATE=1)",
      "Bash(npm rebuild:*)",
      "Bash(npm run seed:*)"
    ]
  }
}
