# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tarkhine_db?schema=public"

# API Documentation
API_DOCS_TITLE=Tarkhine API
API_DOCS_VERSION=1.0.0
API_DOCS_DESCRIPTION=API documentation for Tarkhine backend

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_FORMAT=dev

# Pagination Defaults
DEFAULT_PAGE=1
DEFAULT_LIMIT=10
MAX_LIMIT=100

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Cookie Settings
COOKIE_NAME=token
COOKIE_SECRET=your-cookie-secret-key-change-this
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf
